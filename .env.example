# ============================================================
# Diet Recommendation Pipeline — 환경 변수 템플릿
# 사용법: cp .env.example .env  →  .env 파일에 실제 값 입력
# ============================================================

# Supabase (필수)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key
# Gemini 1.5 Flash - Step 1 원재료명 파싱 (무료 1,500 RPD)
# 발급: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key
# Groq + LLaMA 3.1 8B - Step 2 식사 분류 (무료 6,000 RPD)
# 발급: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# 네이버 쇼핑 API - 가격 검색 (무료 1,000 req/일)
# 발급: https://developers.naver.com/apps/#/register  →  쇼핑 검색 API 선택
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# HACCP 포장지표기정보 API - 알레르기/원재료 공식 데이터 (무료)
# 발급: https://data.go.kr  →  "HACCP 제품이미지 및 포장지표기정보" 검색  →  활용신청 (즉시 발급)
HACCP_API_KEY=your_haccp_api_key